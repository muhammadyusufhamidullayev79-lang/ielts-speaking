{
  "name": "ielts-speaking-pro",
  "version": "1.0.0",
  "private": true,
  "description": "IELTS Speaking Pro — Eagle 9. Veb-sayt + PWA + Android/iOS ilova.",
  "scripts": {
    "build:css": "bash tools/build-css.sh",
    "build:icons": "node tools/build-icons.mjs",
    "build:standalone": "python3 tools/build-standalone.py",
    "build:app": "node tools/build-app.mjs",
    "test": "node --test tests/",
    "serve": "python3 -m http.server 8000",
    "sync": "npm run build:app && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "jsdom": "^30.1.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.10"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  }
}
